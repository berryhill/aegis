package consoleweb

type QueueActionsModel struct {
 Digest, Revision, RequeueReason string
 CanArchive, Archived, CanRequeue, CanReviewRequeue bool
}

templ QueuePresentationActions(surface SurfaceModel, record RecordModel) {
 if record.QueueActions != nil {
  <div class="queue-presentation-actions" aria-label="Queue history actions">
   if record.QueueActions.CanArchive {
    if record.QueueActions.Archived {
     @queuePresentationForm(surface, record, "unarchive", "Unarchive")
    } else {
     @queuePresentationForm(surface, record, "archive", "Archive")
    }
   }
   if record.QueueActions.CanRequeue {
    @queuePresentationForm(surface, record, "requeue", "Requeue failed Doer")
   }
   if record.QueueActions.CanReviewRequeue {
    @queuePresentationForm(surface, record, "requeue-review", "Review exact Requeue continuation")
   }
   <p role="status">{ record.QueueActions.RequeueReason }</p>
  </div>
 }
}

templ queuePresentationForm(surface SurfaceModel, record RecordModel, operation string, label string) {
 <form method="post" action={ "/console/queue/" + queueURLPathEscape(record.Key) + "/" + operation }>
  <input type="hidden" name="csrf" value={ surface.CSRF }/>
  <input type="hidden" name="digest" value={ record.QueueActions.Digest }/>
  <input type="hidden" name="expected_revision" value={ record.QueueActions.Revision }/>
  <button class="secondary" type="submit">{ label }</button>
 </form>
}


templ QueueHistoryFilters(surface SurfaceModel) {
 <form class="toolbar" method="get" action="/console/queue" aria-label="Filter Queue history">
  <label>Lifecycle <select name="state">
   for _, state := range []string{"all", "queued", "claimable", "active", "retrying", "cancelled", "expired", "denied", "failed", "exhausted", "succeeded"} {
    <option value={ state } selected?={ surface.QueueState == state }>{ stateHeading(state) }</option>
   }
  </select></label>
  <label>Visibility <select name="visibility">
   <option value="unarchived" selected?={ surface.QueueVisibility == "unarchived" }>Unarchived</option>
   <option value="archived" selected?={ surface.QueueVisibility == "archived" }>Archived</option>
   <option value="all" selected?={ surface.QueueVisibility == "all" }>All history</option>
  </select></label>
  <button class="secondary" type="submit">Apply</button>
  @CollectionCount(surface, "execution")
 </form>
 <form method="post" action="/console/queue/preferences" aria-label="Save Queue default">
  <input type="hidden" name="csrf" value={ surface.CSRF }/>
  <input type="hidden" name="expected_revision" value={ surface.QueuePreferenceRevision }/>
  <input type="hidden" name="state" value={ surface.QueueState }/>
  <input type="hidden" name="visibility" value={ surface.QueueVisibility }/>
  <button class="secondary" type="submit">Save current view as default</button>
  <a href="/console/queue?state=all&amp;visibility=archived">Archived executions</a>
 </form>
}
