package consoleweb

import (
	"fmt"
	"net/url"
	"strconv"
	"strings"
)

templ Document(model PageModel) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="dark"/>
			<title>{ documentTitle(model) }</title>
			<link rel="stylesheet" href="/console/assets/app.css"/>
			if model.Authenticated {
				<script src="/console/assets/navigation.js" defer></script>
			}
		</head>
		<body data-collection-url={ model.Surface.CollectionURL } data-detail-open={ fmt.Sprintf("%t", model.Surface.InspectorOpen) }>
			<a class="skip" href="#main">Skip to content</a>
			@Header(model.Authenticated, model.CSRF, model.Surface.Title)
			<div class="shell">
				@Navigation(model.Surface.Domain, model.Authenticated)
				<main class="content" id="main" tabindex="-1">
					<div id="workspace">
						if model.Authenticated {
							if model.LoopComposer != nil {
								@LoopComposerPage(*model.LoopComposer, model.CSRF)
							} else if model.CommandPreview != nil {
								@CommandPreviewPage(*model.CommandPreview, model.CSRF)
							} else if model.CommandReceipt != nil {
								@CommandReceiptPage(*model.CommandReceipt)
							} else if model.CharterImport || model.AgentOperation != nil {
								@CharterImportPage(model.CSRF, model.Surface.CharterImportProposal, model.AgentOperation)
							} else if model.CredentialOperation != nil {
								@CredentialOperationPage(model.CSRF, model.CredentialOperation)
							} else {
								@Workspace(model.Surface)
							}
							@PasswordRotation(model.CSRF)
						} else {
							@Authentication(model.Authentication)
						}
					</div>
				</main>
			</div>
		</body>
	</html>
}

templ Header(authenticated bool, csrf string, title string) {
	<header class="topbar" id="console-header">
		<span class="topbar-brand"><span class="brand-mark" aria-hidden="true"></span>Aegis</span>
		<span class="topbar-sep" aria-hidden="true">/</span>
		<span class="topbar-context">{ fallbackTitle(title) }</span>
		if authenticated {
			<span class="topbar-status"><span class="status-dot" aria-hidden="true"></span><span class="ts-full">Authenticated control plane</span><span class="ts-short">Control plane</span></span>
		} else {
			<span class="topbar-status"><span class="status-dot" aria-hidden="true"></span><span class="ts-full">Authentication required</span><span class="ts-short">Signed out</span></span>
		}
		if authenticated {
			<button id="open-password-rotation" type="button" class="ghost btn-sm" commandfor="principal-password-rotation" command="show-modal">Rotate password</button>
			<a class="ghost btn-sm" href="/console/reauthenticate">Reauthenticate</a>
			<form class="logout-form" method="post" action="/console/logout">
				<input type="hidden" name="csrf" value={ csrf }/>
				<button id="logout" class="ghost btn-sm" type="submit">Sign out</button>
			</form>
		}
	</header>
}

templ Navigation(domain string, authenticated bool) {
	<nav class="nav-rail" id="domain-navigation" aria-label="Aegis navigation">
		if authenticated {
			<div class="nav-group-label">Control plane</div>
			@NavigationButton(DomainAgents, "Agent Registry", "Agents", domain == DomainAgents, "agent")
			@NavigationButton(DomainGraphs, "Graphs", "Graphs", domain == DomainGraphs, "graph")
			@NavigationButton(DomainLoops, "Loops", "Loops", domain == DomainLoops, "loop")
			@NavigationButton(DomainQueue, "Execution Queue", "Queue", domain == DomainQueue, "queue")

			@NavigationButton(DomainCredentials, "Credentials", "Credentials", domain == DomainCredentials, "credential")
			<div class="rail-foot"><span class="avatar" aria-hidden="true">OP</span><span class="identity-copy"><strong>Operator context</strong><span>authenticated · local</span></span></div>
		}
	</nav>
}

templ NavigationButton(domain string, label string, short string, current bool, icon string) {
	<a class="nav-item" href={ consoleRoute(domain, "") } data-route={ domain } aria-current={ currentPage(current) }>
		@NavigationIcon(icon)<span class="nav-label">{ label }</span><span class="nav-short">{ short }</span>
	</a>
}

templ NavigationIcon(icon string) {
	if icon == "agent" {
		<svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="8" r="3.2"></circle><path d="M5 20a7 7 0 0 1 14 0"></path></svg>
	} else if icon == "graph" {
		<svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="6" cy="6" r="2.4"></circle><circle cx="18" cy="9" r="2.4"></circle><circle cx="9" cy="18" r="2.4"></circle><path d="M8.1 7 16 8.5M7.3 8.1 8.4 15.7"></path></svg>
	} else if icon == "loop" {
		<svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 12a8 8 0 0 1 8-8 8 8 0 0 1 8 8 8 8 0 0 1-8 8"></path><path d="m12 20-3-3 3-3"></path></svg>
	} else if icon == "queue" {
		<svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10"></path></svg>
	} else {
		<svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="3"></rect><path d="M8 9h8M8 13h8M8 17h5"></path></svg>
	}
}

templ Authentication(model AuthenticationModel) {
	<section id="authentication" class="auth-panel" aria-labelledby="authentication-title">
		<span class="eyebrow">Principal authentication</span>
		<h1 id="authentication-title">Sign the Aegis principal into this browser</h1>
		<p>This signs the principal configured when Aegis was initialized into this browser. It does not create or change the principal, tenant, or authority context.</p>
		<p>Enter the principal password enrolled during approved Aegis initialization. This is separate from the credential-authority passphrase and never selects credential decryption authority.</p>
		<p>The browser cannot select a principal, actor, tenant, trust stanza, mandate, or authority. Successful password verification authenticates only the configured principal; it does not provision identity or grant authority.</p>
		<p id="authentication-status" role="status" aria-live="polite">
			if model.Status != "" {
				{ model.Status } <code>{ model.ReasonCode }</code>
			} else {
				The enrolled principal password is required.
			}
		</p>
		<p class="inline-notice">Password authentication is required for every new browser session. Browser session lifetime: <strong>{ model.SessionTTL }</strong>.</p>
		<form id="session-form" method="post" action="/console/login">
			<label for="password">Principal password</label>
			<input id="password" name="password" type="password" autocomplete="current-password" required/>
			<button class="primary" type="submit">Sign in as the Aegis principal</button>
		</form>
		<div class="service-state" data-state="loading" hidden>Loading authoritative state…</div>
		<div class="service-state" data-state="empty" hidden>The authoritative collection is empty.</div>
		<div class="service-state" data-state="denied" hidden>This collection read was denied. No count is asserted.</div>
		<div class="service-state" data-state="unavailable" hidden>Fleet control is unavailable. This is not an empty collection.</div>
		<div class="service-state" data-state="degraded_repair_required" hidden>Fleet state is degraded and requires repair. No count is asserted.</div>
		<div class="service-state" data-state="error" hidden>Fleet state could not be loaded or validated.</div>
	</section>
}

templ PasswordRotation(csrf string) {
	@Dialog(OverlayModel{
		ID: "principal-password-rotation",
		Title: "Rotate principal password",
		Description: "Set a new password for the authenticated principal. This revokes every existing browser session.",
		CloseLabel: "Cancel password rotation",
	}) {
		<form method="post" action="/console/password">
			<input type="hidden" name="csrf" value={ csrf }/>
			@Notice(NoticeModel{Kind: "warning", Title: "Authentication impact", Message: "You will need to sign in again with the new password after rotation."})
			@FormField(FormFieldModel{ID: "current-password", Name: "current_password", Label: "Current principal password", Required: true, Secret: true, Autocomplete: "current-password"})
			@FormField(FormFieldModel{ID: "new-password", Name: "new_password", Label: "New principal password", Help: "Use at least 12 characters.", Required: true, Secret: true, Autocomplete: "new-password", MinLength: "12"})
			@FormField(FormFieldModel{ID: "confirm-password", Name: "confirmation", Label: "Confirm new principal password", Required: true, Secret: true, Autocomplete: "new-password", MinLength: "12"})
			<label><input name="approve" type="checkbox" value="rotate" required/> I approve replacing the principal-password verifier and revoking all browser sessions.</label>
			@Confirmation(ConfirmationModel{Title: "Confirm password rotation", Message: "This action cannot preserve prior browser authentication.", ConfirmLabel: "Rotate password and sign out everywhere", CancelLabel: "Cancel", DialogID: "principal-password-rotation", Dangerous: true})
		</form>
	}
}

templ Workspace(surface SurfaceModel) {
	if surface.InspectorOpen && surface.Inspector != nil && surface.Domain == DomainGraphs && surface.Inspector.Graph != nil {
		@GraphDetailPage(surface, surface.Inspector)
	} else if surface.InspectorOpen && surface.Inspector != nil && surface.Domain == DomainLoops && surface.Inspector.Loop != nil {
		@LoopDetailPage(surface, surface.Inspector)
	} else if surface.InspectorOpen && surface.Inspector != nil && surface.Domain == DomainQueue && surface.Inspector.Queue != nil {
		@QueueDetailPage(surface, surface.Inspector)
	} else {
		<section class="surface active" id={ "surface-" + surface.Domain } aria-labelledby="surface-title">
		<div class="page-head">
			<div class="surface-header">
				<span class="eyebrow">{ surface.Eyebrow }</span>
				<h1 id="surface-title">{ surface.Title }</h1>
				<p>{ surface.Description }</p>
			</div>
			for _, action := range surface.Actions {
				if action.Primary {
					if surface.Domain == DomainAgents && action.State == "ready" {
						<a class="primary" href="/console/agents/charter-import" title={ actionTitle(action) }>{ action.Label }</a>
					} else if surface.Domain == DomainLoops && action.State == "ready" {
						<a class="primary" href="/console/loops/compose" title={ actionTitle(action) }>{ action.Label }</a>
					} else if surface.Domain == DomainGraphs && surface.Authoritative {
						<a class="primary" href="/console/graphs/compose" title="Compose a candidate; publication still requires fresh exact authority admission">{ action.Label }</a>
					} else if surface.Domain == DomainQueue && surface.Authoritative {
						<a class="primary" href="/console/graphs/run" title="Prepare a typed Graph submission; admission and Queue creation remain server-authoritative">{ action.Label }</a>
					} else if surface.Domain == DomainCredentials && surface.Authoritative {
						<a class="primary" href="/console/credentials/operation?operation=create">Create credential</a>
					} else {
						<button class="primary" type="button" disabled title={ actionTitle(action) }>{ action.Label }</button>
					}
				}
			}
		</div>
		if surface.Domain != DomainQueue {
			@ActionReadiness(surface.Actions)
		}
		<div id="service-status" class="collection-status" data-state={ surface.State } role="status" aria-live="polite">
			<span class="signal" aria-hidden="true"></span><strong>{ surface.Status }</strong>
		</div>
		if surface.State != "ready" && surface.State != "filtered-empty" {
			<div class="service-state" data-state={ surface.State }><strong>{ stateHeading(surface.State) }</strong><span>{ stateMessage(surface.State) }</span><code>{ surface.ReasonCode }</code></div>
		}
		if surface.State == "filtered-empty" {
			if surface.Domain == DomainQueue {
				<div class="panel state-block" data-state="empty"><strong>No executions in this lifecycle view</strong><p>Choose another authoritative Execution Queue state.</p></div>
			} else {
				<div class="panel state-block" data-state="empty"><strong>No matching agents</strong><p>Try another Agent ID, runtime target, owner, source, or lifecycle.</p></div>
			}
		}
		@DomainCollection(surface)
		if surface.Domain != DomainCredentials {
			if surface.Pagination.Label != "" {
				@Pagination(surface.Pagination)
			}
			if surface.Domain == DomainAgents && surface.InspectorOpen && surface.Inspector != nil {
				@AgentInlineDetail(surface, surface.Inspector)
			}
		}
		</section>
	}
}

templ CharterImportPage(csrf string, proposal CharterImportProposal, operation *AgentOperationModel) {
	<section class="surface active" id="charter-import-review" aria-labelledby="charter-import-title">
		<div class="page-head">
			<div class="surface-header">
				<span class="eyebrow">Agent Registry</span>
				<h1 id="charter-import-title">Charter-backed Agent registration</h1>
				<p>Validate and review a pre-imported charter and bounded current-fleet artifact before Agent registration. This workflow does not import the charter.</p>
			</div>
			<a id="charter-import-back" class="ghost" href="/console/agents#/agents">Back to Agent Registry</a>
		</div>
		if operation != nil && operation.Status != "" {
			<div class="collection-status" data-state={ operation.Stage } role="status"><strong>{ operation.Status }</strong>
				if operation.ReasonCode != "" {
					<code>{ operation.ReasonCode }</code>
				}
			</div>
		}
		if operation == nil || operation.Stage == "prepare" || operation.Stage == "error" {
			<section class="panel" aria-label="Prepare Agent registration"><div class="panel-body">
				<div class="section-label">Bounded source artifacts</div>
				<p class="inline-notice">The browser cannot select identity or authority. The authenticated server requires the exact charter revision to exist already, validates both artifacts, and derives the exact candidate.</p>
				<form id="agent-registration-prepare" method="post" action="/console/agents/registration/review">
					<input type="hidden" name="csrf" value={ csrf }/>
					<label for="charter">Charter JSON</label><textarea id="charter" name="charter" required maxlength="131072">{ operationValue(operation, "charter") }</textarea>
					<label for="fixture">Current-fleet fixture JSON</label><textarea id="fixture" name="fixture" required maxlength="131072">{ operationValue(operation, "fixture") }</textarea>
					<label for="fleet-id">Exact fleet ID</label><input id="fleet-id" name="fleet_id" required maxlength="63" value={ operationValue(operation, "fleet") }/>
					<label for="source-id">Exact source ID</label><input id="source-id" name="source_id" required maxlength="63" value={ operationValue(operation, "source") }/>
					<button class="primary" type="submit">Validate and review</button>
				</form>
			</div></section>
		} else if operation.Stage == "review" {
			<section class="panel" aria-label="Exact Agent registration review"><div class="panel-body">
				<div class="section-label">Exact immutable registration proposal</div>
				<dl class="spec"><dt>Agent</dt><dd>{ operation.AgentID }</dd><dt>Fleet source</dt><dd>{ operation.FleetID + " / current-fleet / " + operation.SourceID }</dd><dt>Charter</dt><dd>{ operation.CharterDigest }</dd><dt>Initial Agent revision</dt><dd>{ operation.Revision + " @ " + operation.RevisionDigest }</dd><dt>Runtime</dt><dd>{ operation.Runtime }</dd><dt>Owner</dt><dd>{ operation.Owner }</dd><dt>Accountability</dt><dd>{ operation.Accountability }</dd><dt>Capabilities</dt><dd>{ operation.Capabilities }</dd><dt>Policies</dt><dd>{ operation.Policies }</dd><dt>Lifecycle</dt><dd>{ operation.Lifecycle }</dd></dl>
				<form id="agent-registration-execute" method="post" action="/console/agents/registration/execute">
					<input type="hidden" name="csrf" value={ csrf }/><input type="hidden" name="receipt" value={ operation.Receipt }/>
					<button class="primary" type="submit">Register Agent</button><a class="secondary" href="/console/agents">Cancel</a>
				</form>
			</div></section>
		} else if operation.Stage == "success" {
			<section class="panel"><div class="panel-body"><h2>Authoritative readback</h2><p>{ operation.Status }</p><a class="primary" href={ operation.ResultURL }>Open exact registered Agent</a></div></section>
		}
		<section class="panel" aria-label="CLI alternative"><div class="panel-body">
			<div class="section-label">CLI alternative</div><p class="inline-notice">{ proposal.Notice }</p>
			<dl class="spec"><dt>Validate</dt><dd><code>{ proposal.ValidateCommand }</code></dd><dt>Import</dt><dd><code>{ proposal.ImportCommand }</code></dd></dl>
		</div></section>
	</section>
}

func operationValue(operation *AgentOperationModel, field string) string {
	if operation == nil { return "" }
	switch field { case "charter": return operation.Charter; case "fixture": return operation.Fixture; case "fleet": return operation.FleetID; case "source": return operation.SourceID }
	return ""
}

templ LoopComposerPage(model LoopComposerModel, csrf string) {
	<section class="surface active" aria-labelledby="loop-composer-title">
		<div class="page-head"><div class="surface-header"><span class="eyebrow">Loops</span><h1 id="loop-composer-title">Publish immutable Loop revision</h1><p>Compose a bounded typed revision. Preview creates no Loop record; confirmation repeats target, publisher, principal, stanza, mandate, and authority admission.</p></div><a class="secondary" href="/console/loops">Cancel</a></div>
		@ErrorSummary("Correct the Loop composer", model.Errors)
		<form class="panel panel-body" method="post" action="/console/loops/preview">
			<input type="hidden" name="csrf" value={ csrf }/>
			<label for="loop-publisher">Eligible enabled publisher</label><select id="loop-publisher" name="publisher_id" required>
				for _, publisher := range model.Publishers {
					<option value={ publisher.ID }>{ publisher.ID } · { publisher.Revision } · { publisher.Runtime }</option>
				}
			</select><p class="field-help">The selection is a request only. The server resolves the exact current Agent revision and denies unless it is the sole admitted authority Agent.</p>
			<div class="graph-grid"><div><label for="loop-id">Loop ID</label><input id="loop-id" name="loop_id" required maxlength="128"/></div><div><label for="loop-revision">Revision</label><input id="loop-revision" name="revision" type="number" min="1" required/></div><div><label for="loop-previous">Previous digest</label><input id="loop-previous" name="previous_digest" placeholder="blank for revision 1"/></div><div><label for="loop-key">Publication idempotency key</label><input id="loop-key" name="publication_key" required maxlength="128"/></div><div><label for="loop-entry">Entry step ID</label><input id="loop-entry" name="entry_step_id" required maxlength="128"/></div></div>
			<p class="inline-notice">Line fields use CSV. Quote a value with standard CSV quotes when it contains a comma. Limits: 128 Loop ports, 256 steps, 1,024 transitions, 128 evidence requirements, 10 attempts, and 1,000 traversals.</p>
			@LoopTextarea("loop-inputs", "inputs", "Loop inputs", "id,type,required", false)
			@LoopTextarea("loop-outputs", "outputs", "Loop outputs", "id,type,required", false)
			@LoopTextarea("loop-steps", "steps", "Steps", "id,kind,max_attempts,gate_mode,terminal_outcome", true)
			@LoopTextarea("loop-step-ports", "step_ports", "Step ports", "step_id,input|output,port_id,type,required", false)
			@LoopTextarea("loop-terminal-mappings", "terminal_mappings", "Terminal output mappings", "terminal_step_id,source_port,loop_output_port", false)
			@LoopTextarea("loop-claims", "evidence_claims", "Evidence claims", "step_id,claim,media_type,expected_digest,verifier_id,policy_version", false)
			@LoopTextarea("loop-transitions", "transitions", "Transitions", "id,from_step_id,to_step_id,condition,max_traversals", false)
			@LoopTextarea("loop-mappings", "transition_mappings", "Transition mappings", "transition_id,source_port,target_port", false)
			@LoopTextarea("loop-required-evidence", "required_evidence", "Required evidence", "claim,producer_step_id", false)
			<button class="primary" type="submit" disabled?={ len(model.Publishers) == 0 }>Preview exact publication</button>
		</form>
	</section>
}

templ LoopTextarea(id, name, label, placeholder string, required bool) {
	<div class="form-field"><label for={ id }>{ label }</label><p class="field-help">One { placeholder } record per line.</p><textarea id={ id } name={ name } rows="4" required?={ required } placeholder={ placeholder }></textarea></div>
}

templ CommandPreviewPage(model CommandPreviewModel, csrf string) {
	<section class="surface active" aria-labelledby="command-preview-title"><div class="page-head"><div class="surface-header"><span class="eyebrow">Review exact command</span><h1 id="command-preview-title">Confirm Loop mutation</h1><p>Preview is non-persistent. Confirmation repeats fresh authority and exact target admission.</p></div></div>
		<dl class="exact-reference"><dt>Command</dt><dd>{ model.CommandID }</dd><dt>Target</dt><dd>{ model.TargetID }</dd><dt>Target digest</dt><dd><code>{ model.TargetDigest }</code></dd><dt>Normalized input digest</dt><dd><code>{ model.InputDigest }</code></dd><dt>Expires</dt><dd>{ model.ExpiresAt }</dd></dl>
		<form method="post" action="/console/loops/execute"><input type="hidden" name="csrf" value={ csrf }/><input type="hidden" name="intent_id" value={ model.IntentID }/>@Confirmation(ConfirmationModel{Title: "Confirm exact Loop mutation", Message: "Only the displayed digest-bound intent will execute. Closing or cancelling creates no Loop or lifecycle record.", ConfirmLabel: "Confirm and execute", CancelLabel: "Cancel", Dangerous: model.CommandID == "loop.lifecycle"})</form>
	</section>
}

templ CommandReceiptPage(model OperationReceiptModel) {
	<section class="surface active" aria-labelledby="command-receipt-title"><div class="page-head"><div class="surface-header"><span class="eyebrow">Authoritative readback</span><h1 id="command-receipt-title">Loop operation receipt</h1></div><a class="primary" href="/console/loops">Return to Loops</a></div>@OperationReceipt(model)</section>
}

templ ActionReadiness(actions []ActionModel) {
	if hasBlockedAction(actions) {
		<section class="onboard repair" aria-labelledby="onboard-heading">
			<div class="onboard-head"><span class="signal" aria-hidden="true"></span><div><strong id="onboard-heading">Action prerequisites</strong> <span class="sub">Records stay inspectable while action prerequisites are outstanding.</span></div></div>
			<ul class="onboard-steps">
				for _, action := range actions {
					if action.State != "ready" {
						<li data-state={ action.State }>
							<span class={ "tag " + actionTag(action.State) }><i></i>{ stateHeading(action.State) }</span>
							<div class="ob-copy">
								<strong>{ action.Label }</strong>
								if action.ReasonCode == "authority_context_required" {
									<p>Operation-specific authority has not been selected for this action. This does not mean initial setup is incomplete. Preparing an action does not authorize it; submission still requires fresh admission.</p>
								}
								<p><code>{ action.ReasonCode }</code>
									if len(action.RepairActions) > 0 {
										<span> · Repair: { strings.Join(action.RepairActions, ", ") }</span>
									}
								</p>
							</div>
						</li>
					}
				}
			</ul>
		</section>
	}
}

templ DomainCollection(surface SurfaceModel) {
	if surface.Domain == DomainAgents {
		if surface.Authoritative {
			@AgentFilters(surface)
			<div id="surface-list" class="card-grid" aria-label="Agents">
				for _, record := range surface.Records {
					@AgentCard(surface, record)
				}
			</div>
		} else {
			<div class="list-bar">@CollectionCount(surface, "agent")</div>
		}
	} else if surface.Domain == DomainGraphs || surface.Domain == DomainLoops {
		@DefinitionFilters(surface)
		@RecordPanel(surface)

	} else if surface.Domain == DomainQueue {
		if surface.Authoritative {
			@QueueBand(surface, "active-executions", "Active Executions", "Executions holding an authoritative claimed lifecycle state. Queued records are not promoted into this band.", surface.ActiveRecords, "No claimed executions")
			@QueueBand(surface, "failed-executions", "Failed Executions", "Executions whose authoritative queue projection is failed. Runtime output alone never places a record here.", surface.FailedRecords, "No failed executions")
		}
		<section class="ops-band" aria-labelledby="queue-lifecycle"><div class="band-head"><div class="band-intro"><h2 class="band-title" id="queue-lifecycle">Queue &amp; Lifecycle</h2><p class="band-sub">Every bounded submitted record and the exact lifecycle state retained by Aegis.</p></div></div>
			if surface.Authoritative {
				<div class="toolbar"><nav class="seg-group" aria-label="Authoritative execution states"><span class="filter-label">Lifecycle views</span><a class={ templ.KV("seg", true), templ.KV("active", surface.QueueState == "all") } href={ queueURL("all") }>All</a>
					for _, state := range []string{"Queued", "Claimable", "Active", "Retrying", "Cancelled", "Expired", "Denied", "Failed", "Exhausted", "Succeeded"} {
						<a class={ templ.KV("seg", true), templ.KV("active", surface.QueueState == strings.ToLower(state)) } href={ queueURL(strings.ToLower(state)) }>{ state }</a>
					}
				</nav>@CollectionCount(surface, "execution")</div>
			}
			@QueueRecordPanel(surface, surface.Records)
		</section>
	} else {
		@CredentialWorkspace(surface)
	}
	if len(surface.Records) == 0 && surface.State == "empty" {
		<div class="panel"><div class="empty-state"><strong>No records</strong><span>The authoritative collection read succeeded and returned zero records.</span></div></div>
	}
}

templ QueueBand(surface SurfaceModel, id, title, description string, records []RecordModel, empty string) {
	<section class="ops-band" aria-labelledby={ id }><div class="band-head"><div class="band-intro"><h2 class="band-title" id={ id }>{ title }</h2><p class="band-sub">{ description }</p></div><span class="count">{ countLabel(len(records), "execution") }</span></div>
		if len(records) == 0 {
			<div class="panel"><p class="empty-note queue-empty">{ empty }</p></div>
		} else {
			@QueueRecordPanel(surface, records)
		}
	</section>
}

templ QueueRecordPanel(surface SurfaceModel, records []RecordModel) {
	<div class="panel"><div class="panel-body compact"><ul class="queue-records" aria-label="Execution records">
		for _, record := range records {
			<li><a id={ "record-" + record.Key } class="op-row" data-state={ record.Lifecycle } href={ detailRoute(surface, record.Key) }><span><strong>{ record.Label }</strong><small>{ record.Summary }</small></span><span>{ record.Revision }</span><span class={ "lifecycle " + record.Lifecycle }>{ record.Lifecycle }</span><span>{ record.Runtime }</span></a></li>
		}
	</ul></div></div>
}

templ AgentFilters(surface SurfaceModel) {
	<form class="list-bar" method="get" action="/console/agents" aria-label="Filter Agent Registry">
		<label class="search"><span class="sr-only">Search agents</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m16 16 4.5 4.5"></path></svg><input name="q" type="search" value={ surface.Query } placeholder="Search agents" autocomplete="off" maxlength="128"/></label>
		<label class="lifecycle-filter"><span class="sr-only">Lifecycle</span><select name="lifecycle">
			<option value="all" selected?={ surface.Lifecycle == "all" }>All lifecycle states</option>
			<option value="enabled" selected?={ surface.Lifecycle == "enabled" }>Enabled</option>
			<option value="disabled" selected?={ surface.Lifecycle == "disabled" }>Disabled</option>
			<option value="retired" selected?={ surface.Lifecycle == "retired" }>Retired</option>
		</select></label>
		<button class="secondary" type="submit">Apply</button>
		<span class="count" aria-live="polite">{ fmt.Sprintf("%d of %d agents", len(surface.Records), surface.TotalCount) }</span>
	</form>
}

templ AgentCard(surface SurfaceModel, record RecordModel) {
	<a id={ "record-" + record.Key } class="registry-card" aria-current={ currentPage(surface.Inspector != nil && surface.Inspector.Key == record.Key) } href={ recordURL(surface, record.Key) } data-detail-link data-record-key={ record.Key }>
		<span class="rc-top"><span class="rc-mark" aria-hidden="true">{ agentMark(record.Label) }</span><span class="rc-name"><strong>{ record.Label }</strong><span>{ record.Revision } · { record.Runtime }</span></span>
			if record.Lifecycle != "" {
				<span class={ "lifecycle " + record.Lifecycle }>{ record.Lifecycle }</span>
			}
		</span>
		<span class="rc-chain"><span>{ record.Source }</span><i aria-hidden="true">→</i><span>{ record.Owner }</span></span>
		<dl class="rc-facts"><div><dt>Execution readiness</dt><dd title={ record.Readiness }>{ registryCardReadiness(record.Readiness) }</dd></div><div><dt>Declared authority</dt><dd>{ strings.TrimSuffix(record.Authority, " declared") }</dd></div><div><dt>Provisioning</dt><dd title={ record.Provisioning }>{ registryCardProvisioning(record.Provisioning) }</dd></div></dl>
	</a>
}

templ DefinitionFilters(surface SurfaceModel) {
	<form class="toolbar" method="get" action={ "/console/" + surface.Domain } aria-label={ "Filter " + surface.Title }>
		<label class="lifecycle-filter"><span class="sr-only">Lifecycle</span><select name="lifecycle">
			for _, state := range []string{"all", "draft", "published", "active", "inactive", "retired"} {
				<option value={ state } selected?={ surface.Lifecycle == state }>{ stateHeading(state) }</option>
			}
		</select></label>
		<label class="search" for={ surface.Domain + "-search" }><span class="sr-only">Search { surface.Title }</span><input id={ surface.Domain + "-search" } name="q" type="search" value={ surface.Query } placeholder={ "Search " + surface.Title } autocomplete="off" maxlength="128"/></label>
		<button class="secondary" type="submit">Apply</button><a class="ghost" href={ consoleRoute(surface.Domain, "") }>Clear</a>@CollectionCount(surface, collectionSingular(surface.Domain))
	</form>
}

templ CollectionCount(surface SurfaceModel, singular string) {
	if surface.Authoritative {
		<span class="count">{ countLabel(surface.TotalCount, singular) }</span>
	} else {
		<span class="count">Count unavailable</span>
	}
}

templ RecordPanel(surface SurfaceModel) {
	<div class="panel"><div class="panel-body compact"><ul id="surface-list" class="record-list" aria-label={ surface.Title + " records" }>
		for _, record := range surface.Records {
			<li><a id={ "record-" + record.Key } href={ detailRoute(surface, record.Key) } data-detail-link data-record-key={ record.Key }>@RecordLabel(record.Label)<span>Open exact record →</span></a></li>
		}
	</ul></div></div>
}

templ RecordCard(domain string, record RecordModel) {
	<a class="rec-card" id={ "record-" + record.Key } href={ consoleRoute(domain, record.Key) } data-detail-link data-record-key={ record.Key }><span class="rc-top"><span class="rc-mark" aria-hidden="true">AG</span><strong>{ record.Label }</strong></span><span class="rc-foot">Open exact registered record →</span></a>
}

templ AgentInlineDetail(surface SurfaceModel, record *RecordModel) {
	<aside id="agent-inline-detail" class="inspector agent-inline-detail" aria-labelledby="agent-detail-title" tabindex="-1" autofocus data-composition="agent-inline">
		<div class="detail-head"><div class="detail-title"><h2 id="agent-detail-title">{ record.Label }</h2><p><span class="sr-only">Exact Agent revision </span>{ record.Revision } · <span class={ "lifecycle " + record.Lifecycle }>{ record.Lifecycle }</span></p></div><div class="detail-actions"><a class="secondary" href={ agentRevisionRoute(surface, record) }>Refresh authority evidence</a><a id="close-inspector" class="secondary" href={ collectionRoute(surface) }>Back to Registry</a></div></div>
		if record.Agent != nil {
			<div class="panel-body">
				<div class="section-label">Readiness</div>
				<div class="inline-notice">{ record.Readiness }</div>
				<div class="section-label">Charter revision</div>
				<dl class="spec"><dt>Agent ID</dt><dd>{ record.Agent.StableID }</dd><dt>Charter revision</dt><dd>{ fmt.Sprintf("%s r%d", record.Agent.CharterID, record.Agent.CharterRevision) }</dd><dt>Charter digest</dt><dd>{ record.Agent.CharterDigest }</dd><dt>Runtime target</dt><dd>{ record.Agent.RuntimeAdapter + " / " + record.Agent.Runtime + " / " + record.Agent.RuntimeTarget }</dd><dt>Registry revision</dt><dd>{ fmt.Sprintf("r%d @ %s", record.Agent.Revision, record.Agent.RevisionDigest) }</dd></dl>
				<p class="charter-evidence-note">{ record.Agent.CharterEvidence }</p>
				<section class="agent-evidence-card" aria-label="Provisioning evidence">
					<div class="section-label">Provisioning evidence</div>
					if len(record.Agent.ReceiptFields) > 0 {
						<span class="evidence-status">Recorded receipt evidence</span>
					}
					<p>{ record.Agent.ProvisioningEvidence }</p>
					@FieldList(record.Agent.ReceiptFields, "No exact-bound receipt evidence available")
				</section>
				<details><summary>Charter revision history · { strconv.Itoa(len(record.Agent.CharterHistory)) }</summary><p>{ record.Agent.CharterHistoryEvidence }</p>@FieldList(record.Agent.CharterHistory, "No verified charter revisions available")<h3>Registry revision history</h3><p>{ record.Agent.HistoryEvidence }</p>@RelatedRecords(record.Agent.History)</details>
				<section aria-label="Effective authority" data-authority-state={ record.Agent.AuthorityState }>
					<div class="section-label">Effective authority</div>
					<p class="inline-notice authority-result"><strong>{ record.Agent.AuthorityState }</strong> · { record.Agent.EffectiveAuthority }</p>
					<dl class="spec"><dt>Evaluated for authenticated operator</dt><dd>{ record.Agent.EvaluatedFor }</dd></dl>
					@FieldList(record.Agent.AuthorityFields, "No effective permissions asserted")
				</section>
				<p>Declared stanza policy below is what the exact charter revision contains, not what this operator holds. Permissions are never unioned across stanzas. This page issues no mandate or runtime authority.</p>
				<details><summary>All trust stanza declarations · { strconv.Itoa(len(record.Agent.Stanzas)) }</summary>
					for _, stanza := range record.Agent.Stanzas {
						<section class="panel-body" aria-label={ "Declared stanza " + stanza.ID }><h3>{ stanza.Name } · { stanza.ID }</h3><p>Enabled: { strconv.FormatBool(stanza.Enabled) } · declaration only</p>@FieldList(stanza.Fields, "Declaration unavailable")</section>
					}
				</details>
				<section class="agent-evidence-card" aria-label="Current session and execution">
					<div class="section-label">Current session and execution</div>
					if len(record.Agent.SessionFields) > 0 {
						<span class="evidence-status">Recorded session evidence</span>
					}
					<p>{ record.Agent.SessionEvidence }</p>
					@FieldList(record.Agent.SessionFields, "No exact-bound session evidence available")
					@RelatedRecords(record.Agent.Executions)
				</section>
				<details><summary>Registry provenance and related definitions</summary><dl class="spec"><dt>Fleet source</dt><dd>{ record.Agent.FleetID + " / " + record.Agent.SourceKind + " / " + record.Agent.SourceID }</dd><dt>Owner</dt><dd>{ record.Agent.OwnerID }</dd><dt>Accountability</dt><dd>{ record.Agent.AccountabilityID }</dd><dt>Declared capabilities</dt><dd>{ strings.Join(record.Agent.Capabilities, ", ") }</dd><dt>Declared policies</dt><dd>{ strings.Join(record.Agent.Policies, "\n") }</dd></dl>@RelatedRecords(record.Links)</details>
				if record.Agent.LifecycleEligible {
					<div class="section-label">Lifecycle controls</div>
					if record.Lifecycle == "enabled" {
						@AgentLifecycleForm(surface, record, "disabled", "Disable Agent", false)
					} else {
						@AgentLifecycleForm(surface, record, "enabled", "Enable Agent", false)
					}
					@AgentLifecycleForm(surface, record, "retired", "Retire Agent permanently", true)
				}
			</div>
		} else {
			<div class="panel-body"><div class="inline-notice">{ record.Readiness }. Readiness is derived from the immutable lifecycle record; this browser view grants no runtime authority.</div>@RelatedRecords(record.Links)<div class="section-label">Legacy structured readback unavailable</div>@FieldList(record.Fields, "No Agent detail projection")</div>
		}
	</aside>
}

templ Inspector(surface SurfaceModel, record *RecordModel, open bool) {
	<aside id="inspector" class="inspector" aria-labelledby="inspector-title" tabindex="-1" hidden?={ !open }>
		if record != nil {
			if record.Queue != nil {
				<section class="surface active queue-detail-page" id="inspector-queue" aria-labelledby="inspector-title">
					@QueueWorkspace(surface, record, buildQueuePinnedTopology(record.Queue))
				</section>
			} else if record.Graph != nil {
				@GraphInspector(surface, record)
			} else if record.Credential != nil {
				@CredentialInspector(surface, record)
			} else if record.Loop != nil {
				@LoopInspector(surface, record)
			} else if len(record.Fields) > 0 {
				<div class="detail-head"><div class="detail-title"><h2 id="inspector-title">{ record.Label }</h2><p>{ record.Revision } · <span class={ "lifecycle " + record.Lifecycle }>{ record.Lifecycle }</span></p></div><a id="close-inspector" class="secondary" href={ registryURL(surface) }>Back to Registry</a></div>
				<div class="panel-body">
					<div class="section-label">Readiness</div><div class="inline-notice">{ record.Readiness }. Readiness is derived from the immutable lifecycle record; this browser view grants no runtime authority.</div>
					@RelatedRecords(record.Links)
					<div class="section-label">Provenance and authority</div>
					<dl id="inspector-fields" class="spec">
						for _, field := range record.Fields {
							<dt>{ field.Label }</dt><dd>{ field.Value }</dd>
						}
					</dl>
					if surface.Domain == DomainAgents && record.Lifecycle != "retired" {
						<div class="section-label">Lifecycle controls</div>
						if record.Lifecycle == "enabled" {
							@AgentLifecycleForm(surface, record, "disabled", "Disable Agent", false)
						} else {
							@AgentLifecycleForm(surface, record, "enabled", "Enable Agent", false)
						}
						@AgentLifecycleForm(surface, record, "retired", "Retire Agent permanently", true)
					}
				</div>
			} else {
				<a id="close-inspector" class="back-crumb" href={ consoleRoute(surface.Domain, "") } aria-label="Close inspector">← Back to { surface.Domain }</a>
				<h2 id="inspector-title">Record inspector</h2><p id="inspector-summary">{ record.Summary }</p><pre id="inspector-record">{ record.JSON }</pre>
			}
		}
	</aside>
}

templ AgentLifecycleForm(surface SurfaceModel, record *RecordModel, lifecycle, label string, irreversible bool) {
	<form class="lifecycle-form" method="post" action={ "/console/agents/" + url.PathEscape(record.Key) + "/lifecycle" }>
		<input type="hidden" name="csrf" value={ surface.CSRF }/><input type="hidden" name="revision" value={ strings.TrimPrefix(record.Revision, "r") }/><input type="hidden" name="digest" value={ record.Digest }/><input type="hidden" name="lifecycle" value={ lifecycle }/>
		if irreversible {
			<label><input type="checkbox" name="confirm_retirement" value="retire" required/> I understand retirement is irreversible.</label>
		}
		<button class={ templ.KV("secondary", !irreversible), templ.KV("danger", irreversible) } type="submit">{ label }</button>
	</form>
}

templ LoopInspector(surface SurfaceModel, record *RecordModel) {
	@LoopWorkspace(surface, record, buildLoopTopology(record.Loop))
}

templ LoopDetailPage(surface SurfaceModel, record *RecordModel) {
	<section class="surface active loop-detail-page" id="loop-detail" aria-labelledby="inspector-title" tabindex="-1" autofocus data-composition="loop-replacement" data-route={ consoleRoute(DomainLoops, record.Key) }>
		@LoopWorkspace(surface, record, buildLoopTopology(record.Loop))
	</section>
}

func loopEvidenceCount(detail *LoopDetailModel) int {
	count := len(detail.RequiredEvidence)
	for _, step := range detail.Steps { count += len(step.EvidenceClaims) }
	return count
}

func loopTraversalBoundCount(transitions []LoopTransitionModel) string {
	count := 0
	for _, transition := range transitions { if transition.MaxTraversals > 0 { count++ } }
	return fmt.Sprintf("%d declared", count)
}

func loopValidationOutcome(value string) string {
	if value == "" { return "Unavailable" }
	if index := strings.Index(value, " · "); index >= 0 { return value[:index] }
	return value
}

func loopValidationClass(value string) string {
	outcome := strings.ToLower(loopValidationOutcome(value))
	if outcome == "valid" { return "valid" }
	if outcome == "unavailable" { return "unavailable" }
	return "invalid"
}

func loopRunGraphURL(record *RecordModel) string {
	seen := map[string]struct{}{}
	exact := ""
	for _, link := range record.Links {
		if !strings.HasPrefix(link.Label, "Bound Graph") { continue }
		if _, exists := seen[link.URL]; exists { continue }
		seen[link.URL] = struct{}{}
		exact = link.URL
	}
	if len(seen) == 1 { return exact }
	return "/console/graphs#/graphs"
}

func loopRunGraphLabel(links []LinkModel) string {
	seen := map[string]struct{}{}
	for _, link := range links {
		if strings.HasPrefix(link.Label, "Bound Graph") { seen[link.URL] = struct{}{} }
	}
	if len(seen) == 0 { return "Find a Graph" }
	if len(seen) == 1 { return "Run from a Graph" }
	return "Choose a Graph"
}

func loopEdgeLabel(transition LoopTransitionModel) string {
	if transition.Condition != "" { return transition.Condition }
	return transition.ID
}
templ LoopPorts(ports []LoopPortModel, empty string) {
	if len(ports) == 0 {
		<p class="empty-note">{ empty }</p>
	}
	if len(ports) > 0 {
		<dl class="loop-port-list">
			for _, port := range ports {
				<div><dt>{ port.ID }</dt><dd>{ port.Type }</dd><dd>{ loopRequiredLabel(port.Required) }</dd></div>
			}
		</dl>
	}
}

templ LoopMappings(mappings []LoopPortMappingModel, empty string) {
	if len(mappings) == 0 {
		<p class="empty-note">{ empty }</p>
	}
	if len(mappings) > 0 {
		<ul class="mapping-list">
			for _, mapping := range mappings {
				<li><code>{ mapping.SourcePort }</code><span aria-hidden="true">→</span><code>{ mapping.TargetPort }</code></li>
			}
		</ul>
	}
}

func loopRequiredLabel(required bool) string {
	if required { return "Required" }
	return "Optional"
}

func loopTraversalLabel(bound uint16) string {
	if bound == 0 { return "No traversal bound declared" }
	return fmt.Sprintf("Maximum %d", bound)
}

func loopOptionalLabel(value string) string {
	if value == "" { return "Not declared" }
	return value
}

func loopLatestVersion(record *RecordModel) string {
	if record == nil || record.Loop == nil { return "Unavailable" }
	if record.Loop.LatestVersion != "" { return record.Loop.LatestVersion }
	return record.Revision
}

func loopGraphChildSummary(record *RecordModel) string {
	if record == nil { return "Unavailable" }
	if record.Loop.GraphChildSummary != "" { return record.Loop.GraphChildSummary }
	bound := 0
	for _, link := range record.Links {
		if strings.HasPrefix(link.Label, "Bound Graph") { bound++ }
	}
	switch bound {
	case 0:
		return "No Graph binds this exact revision. The Loop can only run after a Graph binds its ID, revision, and digest."
	case 1:
		return "Exactly one Graph binds this exact revision. Submitting that Graph is the only path to runtime execution."
	default:
		return fmt.Sprintf("%d Graph(s) bind this exact revision. Each binding admits its own run, but every consequential effect still requires fresh authority admission against the Graph-child.", bound)
	}
}

func loopCycleMembersLabel(members []string) string {
	if len(members) == 0 { return "Not detected" }
	return strings.Join(members, ", ")
}

func loopTimeoutLabel(seconds uint32) string {
	if seconds == 0 { return "Not declared" }
	return fmt.Sprintf("%d second(s)", seconds)
}

func loopEntryLabel(entry bool) string {
	if entry { return "Yes" }
	return "No"
}

func loopNodeBadge(step LoopStepModel) string {
	switch {
	case step.Entry:
		return "ENTRY"
	case step.TerminalOutcome != "":
		return strings.ToUpper(step.TerminalOutcome)
	default:
		return ""
	}
}

templ LoopLifecycleForm(csrf string, detail *LoopDetailModel, state, label string, dangerous bool) {
	<form method="post" action="/console/loops/lifecycle-preview"><input type="hidden" name="csrf" value={ csrf }/><input type="hidden" name="target_id" value={ detail.TargetID }/><input type="hidden" name="expected_digest" value={ detail.Digest }/><input type="hidden" name="publisher_id" value={ detail.PublisherID }/><input type="hidden" name="state" value={ state }/><input type="hidden" name="expected_previous_digest" value={ detail.ExpectedLifecycleDigest }/><input type="hidden" name="idempotency_key" value={ detail.TargetID + "-" + state + "-" + detail.ExpectedLifecycleDigest }/><button type="submit" class={ templ.KV("secondary", !dangerous), templ.KV("danger-button", dangerous) }>{ label }</button></form>
}

templ QueueDetailPage(surface SurfaceModel, record *RecordModel) {
	<section class="surface active queue-detail-page" id="queue-detail" aria-labelledby="inspector-title" tabindex="-1" autofocus data-composition="queue-replacement" data-route={ consoleRoute(DomainQueue, record.Key) }>
		if record == nil || record.Queue == nil {
			<section class="surface active" aria-labelledby="inspector-title"><div class="record-head"><div><span class="eyebrow">Execution Queue</span><h2 id="inspector-title">Queue record unavailable</h2></div></div><p class="empty-note">No pinned record resolved for this route.</p></section>
		} else {
			@QueueWorkspace(surface, record, buildQueuePinnedTopology(record.Queue))
		}
	</section>
}

templ GraphInspector(surface SurfaceModel, record *RecordModel) {
	@GraphWorkspace(surface, record, buildGraphTopology(record.Graph))
}

templ GraphDefinitionDetails(record *RecordModel) {
	<div class="graph-definition-details">
		<section class="graph-contract" aria-labelledby="graph-provenance"><h3 id="graph-provenance">Exact provenance</h3><dl class="spec"><dt>Revision digest</dt><dd>{ record.Graph.Digest }</dd><dt>Previous digest</dt><dd>{ record.Graph.PreviousDigest }</dd><dt>Stored validation</dt><dd>{ record.Graph.Validation }</dd></dl>@RelatedRecords(record.Graph.Links)</section>
		<section class="graph-grid" aria-label="Graph contracts"><div><h3>Input schema</h3>@FieldList(record.Graph.InputSchema, "No Graph inputs")</div><div><h3>Output schema</h3>@FieldList(record.Graph.OutputSchema, "No Graph outputs")</div><div><h3>Admission policies</h3>@FieldList(record.Graph.Policies, "No admission policies")</div></section>
		<section aria-labelledby="accepted-submissions"><h3 id="accepted-submissions">Accepted submission snapshots</h3>
			if len(record.Graph.AcceptedRuns) == 0 {
				<p class="empty-note">No accepted run snapshots bind this exact revision.</p>
			}
			for _, run := range record.Graph.AcceptedRuns {
				<article class="snapshot-card"><dl class="spec"><dt>Submission</dt><dd>{ run.Submission }</dd><dt>Snapshot</dt><dd>{ run.Snapshot }</dd><dt>Queue item</dt><dd>{ run.QueueItem }</dd><dt>Graph run</dt><dd>{ run.GraphRun }</dd><dt>Authority context</dt><dd>{ run.Authority }</dd><dt>Mandate</dt><dd>{ run.Mandate }</dd><dt>Runtime</dt><dd>{ run.Runtime }</dd><dt>Normalized inputs</dt><dd>{ run.Inputs }</dd></dl></article>
			}
		</section>
		<section aria-labelledby="rejected-submissions"><h3 id="rejected-submissions">Durable rejected submissions</h3><p class="inline-notice">Rejections do not carry a Graph reference and are therefore shown as fleet-wide submission truth, never attributed to this Graph.</p>@FieldList(record.Graph.RejectedSubmissions, "No durable rejections")</section>
		if record.JSON != "" {
			<details><summary>Exact Graph record JSON</summary><pre class="graph-record-json">{ record.JSON }</pre></details>
		}
	</div>
}

templ GraphDetailPage(surface SurfaceModel, record *RecordModel) {
	<section class="surface active graph-detail-page" id="graph-detail-page" aria-labelledby="inspector-title" tabindex="-1" autofocus data-composition="graph-replacement" data-route={ consoleRoute(DomainGraphs, record.Key) }>
		@GraphInspector(surface, record)
	</section>
}

templ FieldList(fields []FieldModel, empty string) {
	if len(fields) == 0 {
		<p class="empty-note">{ empty }</p>
	} else {
		<dl class="spec">
			for _, field := range fields {
				<dt>{ field.Label }</dt><dd>{ field.Value }</dd>
			}
		</dl>
	}
}

templ RelatedRecords(links []LinkModel) {
	if len(links) > 0 {
		<div class="section-label">Related exact records</div><ul class="record-list related-records">
			for _, link := range links {
				<li><a href={ link.URL }><span><strong>{ link.Label }</strong><small>{ link.Detail }</small></span><span>Open exact record →</span></a></li>
			}
		</ul>
	}
}

templ CredentialOperationPage(csrf string, operation *CredentialOperationModel) {
	<section class="surface active" aria-labelledby="credential-operation-title">
		if operation.Stage != "review" {
			<nav class="crumb-row" aria-label="Breadcrumb"><a class="back-crumb" href="/console/credentials">← Cancel and return to Credentials</a></nav>
		}
		<span class="eyebrow">Reviewed credential operation</span><h1 id="credential-operation-title">{ credentialOperationTitle(operation.Operation) }</h1>
		<p>Only encrypted-authority metadata is rendered. Secret values are one-use, never repopulated, and cleared after every response.</p>
		if operation.Status != "" {
			<p role="status">{ operation.Status }
				if operation.ReasonCode != "" {
					<code>{ operation.ReasonCode }</code>
				}
			</p>
		}
		if operation.Result != nil {
			@OperationReceipt(*operation.Result)
		}
		if operation.Stage == "review" {
			<div class="panel"><div class="panel-body"><h2>Review exact operation</h2>@CredentialOperationMetadata(operation)
			<section class={ "confirmation " + dangerClass(operation.Operation == "revoke") } aria-label="Confirm reviewed operation"><h3>Confirm reviewed operation</h3><p>Authority and current record state are revalidated before mutation. Cancel consumes this exact receipt and immediately wipes its retained payload.</p><div class="button-row">
				<form method="post" action="/console/credentials/operation/cancel" autocomplete="off"><input type="hidden" name="csrf" value={ csrf }/><input type="hidden" name="receipt" value={ operation.Receipt }/><button class="ghost" type="submit">Cancel and wipe review</button></form>
				<form method="post" action="/console/credentials/operation/execute" autocomplete="off"><input type="hidden" name="csrf" value={ csrf }/><input type="hidden" name="receipt" value={ operation.Receipt }/><button type="submit" class={ confirmClass(operation.Operation == "revoke") }>Confirm</button></form>
			</div></section></div></div>
		} else if operation.Result == nil {
			<form class="panel" method="post" action="/console/credentials/operation/review" autocomplete="off"><div class="panel-body"><input type="hidden" name="csrf" value={ csrf }/><input type="hidden" name="operation" value={ operation.Operation }/>
				@CredentialOperationFields(operation)
				<div class="button-row"><a class="ghost" href="/console/credentials">Cancel</a><button class="primary" type="submit">Review</button></div>
			</div></form>
		}
	</section>
}

templ CredentialOperationFields(operation *CredentialOperationModel) {
	if operation.Operation == "create" {
		@FormField(FormFieldModel{ID:"reference", Name:"reference", Label:"Reference", Value:operation.Reference, Required:true})
		@FormField(FormFieldModel{ID:"kind", Name:"kind", Label:"Kind", Value:operation.Kind, Required:true})
	}
	if operation.Operation == "rotate" || operation.Operation == "revoke" || operation.Operation == "bind" {
		@FormField(FormFieldModel{ID:"record_id", Name:"record_id", Label:"Exact record ID", Value:operation.RecordID, Required:true})
	}
	if operation.Operation == "create" || operation.Operation == "rotate" {
		@FormField(FormFieldModel{ID:"credential-value", Name:"value", Label:"Credential value", Secret:true, Required:true, Autocomplete:"new-password"})
	}
	if operation.Operation == "revoke" {
		@FormField(FormFieldModel{ID:"version", Name:"version", Label:"Exact version", Type:"number", Value:operation.Version, Required:true})
		@FormField(FormFieldModel{ID:"reason", Name:"reason", Label:"Revocation reason", Value:operation.Reason, Required:true})
	}
	if operation.Operation == "bind" {
		@FormField(FormFieldModel{ID:"agent-id", Name:"agent_id", Label:"Agent ID", Value:operation.AgentID, Required:true})
		@FormField(FormFieldModel{ID:"stanza-id", Name:"stanza_id", Label:"Stanza ID", Value:operation.StanzaID, Required:true})
		@FormField(FormFieldModel{ID:"deployment-id", Name:"deployment_id", Label:"Deployment ID", Value:operation.DeploymentID, Required:true})
		@FormField(FormFieldModel{ID:"scope", Name:"scope", Label:"Scope", Value:operation.Scope, Required:true})
		@FormField(FormFieldModel{ID:"destinations", Name:"destinations", Label:"Destinations (comma separated)", Value:operation.Destinations, Required:true})
		@FormField(FormFieldModel{ID:"mode", Name:"mode", Label:"Mode", Value:operation.Mode, Required:true})
		@FormField(FormFieldModel{ID:"version-policy", Name:"version_policy", Label:"Version policy", Value:operation.VersionPolicy, Required:true})
		@FormField(FormFieldModel{ID:"pinned-version", Name:"pinned_version", Label:"Pinned version", Type:"number", Value:operation.PinnedVersion})
	}
}

templ CredentialOperationMetadata(operation *CredentialOperationModel) {
	<dl class="spec"><dt>Operation</dt><dd>{ operation.Operation }</dd>
	if operation.RecordID != "" {
		<dt>Exact record</dt><dd><code>{ operation.RecordID }</code></dd>
	}
	if operation.Reference != "" {
		<dt>Reference</dt><dd>{ operation.Reference }</dd>
	}
	if operation.Version != "" {
		<dt>Exact version</dt><dd>{ operation.Version }</dd>
	}
	if operation.Scope != "" {
		<dt>Exact binding tuple</dt><dd><code>{ operation.AgentID + " / " + operation.StanzaID + " / " + operation.DeploymentID + " / " + operation.Scope }</code></dd>
	}
	</dl>
}

func credentialOperationTitle(operation string) string { switch operation { case "create": return "Create credential"; case "rotate": return "Rotate credential"; case "revoke": return "Revoke credential"; case "bind": return "Create exact binding"; case "backup": return "Create policy-constrained backup" }; return "Credential operation denied" }

templ CredentialWorkspace(surface SurfaceModel) {
	if !surface.Authoritative {
		<section class="workspace" aria-label="Credential workspace"><div class="inventory"><div class="pane-head"><span class="count">Count unavailable</span></div><div class="panel"><p class="empty-note">The credential authority is unavailable; no count is asserted. { surface.ReasonCode }</p></div></div></section>
	} else {
		<section class="workspace credential-workspace" aria-label="Credential workspace" data-pane={ credentialPane(surface) }>
			<div class="inventory" id="credential-inventory" tabindex="-1" aria-label="Credential inventory">
				<div class="pane-head">
					<form class="filter-row" method="get" action="/console/credentials" aria-label="Filter Credentials">
						<span class="filter-label">Status</span>
						<label class="lifecycle-filter"><span class="sr-only">Status</span><select name="status">
							<option value="all" selected?={ surface.Lifecycle == "" || surface.Lifecycle == "all" }>All</option>
							<option value="active" selected?={ surface.Lifecycle == "active" }>Active</option>
							<option value="revoked" selected?={ surface.Lifecycle == "revoked" }>Revoked</option>
						</select></label>
						<label class="search"><span class="sr-only">Search credentials</span><input name="q" type="search" value={ surface.Query } placeholder="Search credentials" autocomplete="off" maxlength="128"/></label>
						<button class="secondary" type="submit">Apply</button><a class="ghost" href="/console/credentials">Clear</a>
						<span class="count" aria-live="polite">{ fmt.Sprintf("%d matching in bounded collection · %d authoritative total", credentialMatchingCount(surface), surface.TotalCount) }</span>
					</form>
				</div>
				if surface.State == "filtered-empty" {
					<div class="panel state-block" data-state="empty"><strong>No matching credentials</strong><p>Adjust the status filter or search to see more encrypted records.</p></div>
				} else if len(surface.Records) == 0 {
					<div class="panel"><div class="empty-state"><strong>No credentials</strong><span>The encrypted authority is empty. Run <code>aegis secret put</code> to create the first record.</span></div></div>
				} else {
					<div class="panel credential-table-wrap"><table id="surface-list" class="credential-table">
						<caption class="sr-only">Encrypted credential records</caption>
						<thead><tr><th scope="col">Reference</th><th scope="col">Kind</th><th scope="col">Status</th><th scope="col">Version</th></tr></thead>
						<tbody>
						for _, record := range surface.Records {
							<tr data-selected={ fmt.Sprintf("%t", surface.Inspector != nil && surface.Inspector.Key == record.Key) }><th scope="row"><a id={ "record-" + record.Key } href={ detailRoute(surface, record.Key) } data-detail-link data-record-key={ record.Key } aria-current={ credentialCurrent(surface, record.Key) }><strong>{ credentialReference(record) }</strong><small>{ record.Key }</small></a></th><td>{ credentialKind(record) }</td><td><span class={ "lifecycle " + record.Lifecycle }>{ record.Lifecycle }</span></td><td>{ record.Revision }</td></tr>
						}
						</tbody>
					</table></div>
					if surface.Pagination.Label != "" {
						@Pagination(surface.Pagination)
					}
				}
			</div>
			<aside class="detail credential-detail" aria-label="Selected credential" tabindex="-1" autofocus?={ surface.Inspector != nil } data-composition="credential-master-detail">
				if surface.Inspector != nil && surface.Inspector.Credential != nil {
					@CredentialInspector(surface, surface.Inspector)
				} else if surface.InspectorOpen {
					<nav class="crumb-row" aria-label="Breadcrumb"><a id="close-inspector" class="back-crumb" href={ collectionRoute(surface) }>← Back to Credentials</a></nav>
					<h2 id="inspector-title">Credential unavailable</h2><p>The requested record was not returned by the authority. No credential metadata is asserted.</p>
				} else {
					<strong>Select an encrypted credential</strong>
					<p>Inspect metadata and immutable version history. A stored value is never read, entered or shown here.</p>
				}
			</aside>
		</section>
	}
}

templ CredentialInspector(surface SurfaceModel, record *RecordModel) {
	<nav class="crumb-row" aria-label="Breadcrumb"><a id="close-inspector" class="back-crumb" href={ collectionRoute(surface) }>← Back to Credentials</a></nav>
	if record == nil || record.Credential == nil {
		<h2 id="inspector-title">Credential inspector</h2>
		<p>No encrypted credential selected.</p>
	} else {
		<div class="detail-head"><div class="detail-title"><h2 id="inspector-title">{ record.Credential.Reference }</h2><p>{ record.Key } · <span class={ "lifecycle " + record.Lifecycle }>{ record.Lifecycle }</span></p></div>
			if record.Lifecycle == "active" {
				<div class="button-row"><a class="secondary" href={ credentialOperationURL("rotate", record.Credential.ID) }>Prepare rotation</a><a class="secondary" href={ credentialOperationURL("revoke", record.Credential.ID) }>Prepare revoke</a><a class="secondary" href={ credentialOperationURL("bind", record.Credential.ID) }>Prepare exact binding</a></div>
			}
		</div>
		<div class="panel-body">
			if record.Lifecycle == "revoked" {
				<div class={ "execution-alert revoked" }><strong>Revoked credential</strong><span>This credential record is terminal. Secret value reads are denied; record metadata and immutable version history remain inspectable here.</span></div>
			}
			<div class="section-label">Metadata</div>
			<dl class="spec">
				<dt>Stable record ID</dt><dd>{ credFallback(record.Credential.ID, record.Key) }</dd>
				<dt>Reference</dt><dd>{ record.Credential.Reference }</dd>
				<dt>Kind</dt><dd>{ record.Credential.Kind }</dd>
				<dt>Status</dt><dd><span class={ "lifecycle " + record.Credential.Status }>{ record.Credential.Status }</span></dd>
				<dt>Current version</dt><dd>{ fmt.Sprintf("v%d", record.Credential.CurrentVersion) }</dd>
				<dt>Created</dt><dd>{ record.Credential.CreatedAt }</dd>
				<dt>Created by</dt><dd>{ record.Credential.CreatedBy }</dd>
				<dt>Bindings</dt><dd>{ fmt.Sprintf("%d credential binding(s)", record.Credential.BindingCount) }</dd>
				if record.Credential.Status == "revoked" {
					<dt>Revoked at</dt><dd>{ record.Credential.RevokedAt }</dd>
					<dt>Revocation reason</dt><dd>{ record.Credential.Revocation }</dd>
				}
			</dl>

			<div class="section-label">Version history (encrypted, metadata-only)</div>
			if len(record.Credential.Versions) == 0 {
				<p class="empty-note">No encrypted versions on record.</p>
			} else {
				<div class="credential-table-wrap"><table class="credential-table credential-versions"><caption class="sr-only">Immutable versions of { record.Credential.Reference }</caption><thead><tr><th scope="col">Version</th><th scope="col">Created</th><th scope="col">Stored value</th></tr></thead><tbody>
					for _, version := range record.Credential.Versions {
						<tr><th scope="row">{ fmt.Sprintf("v%d", version.Version) }
							if version.Version == record.Credential.CurrentVersion {
								<span class="lifecycle">current</span>
							}
						</th><td><time>{ version.CreatedAt }</time></td><td>Concealed · { credFallback(version.CiphertextHash, "Content address unavailable") }</td></tr>
					}
				</tbody></table></div>
				<p class="inline-notice">Rotation appends a new encrypted version; existing versions are never rewritten. The stored-value column is a content address over encrypted bytes, not credential material.</p>
			}
			<p class="inline-notice">Secret values, ciphertext, wrapped DEKs, nonces and KEK bytes are never shown here. Prepare actions open a separate authenticated review; selection never grants authority. Initialize, unlock, reveal, restore, arbitrary-path backup and custody selection remain outside this workspace.</p>
		</div>
	}
}

func credentialPane(surface SurfaceModel) string {
	if surface.InspectorOpen || surface.Inspector != nil { return "detail" }
	return "list"
}

func credentialCurrent(surface SurfaceModel, key string) string {
	if surface.Inspector != nil && surface.Inspector.Key == key { return "true" }
	return "false"
}

func credentialReference(record RecordModel) string {
	if record.Credential != nil { return credFallback(record.Credential.Reference, record.Key) }
	return record.Key
}

func credentialKind(record RecordModel) string {
	if record.Credential != nil { return record.Credential.Kind }
	return "Unavailable"
}

func credentialMatchingCount(surface SurfaceModel) int {
	if surface.TotalRecords == 0 && len(surface.Records) > 0 { return len(surface.Records) }
	return surface.TotalRecords
}

func credentialOperationURL(operation, recordID string) string {
	values := url.Values{"operation": {operation}}
	if recordID != "" { values.Set("record_id", recordID) }
	return "/console/credentials/operation?" + values.Encode()
}

func credentialMark(label string) string {
	label = strings.TrimSpace(label)
	if label == "" { return "?" }
	return strings.ToUpper(string([]rune(label)[0]))
}

func credFallback(value, replacement string) string {
	if value == "" { return replacement }
	return value
}

templ RecordLabel(label string) { <span>{ label }</span> }

func consoleRoute(domain, recordKey string) string {
	path := fmt.Sprintf("/console/%s", domain)
	if recordKey != "" {
		path += "?record_key=" + url.QueryEscape(recordKey)
		return path + "#/" + domain + "/" + url.PathEscape(recordKey)
	}
	return path + "#/" + domain
}

func queueURL(state string) string {
	values := url.Values{}
	if state != "" && state != "all" { values.Set("state", state) }
	path := "/console/queue"
	if encoded := values.Encode(); encoded != "" { path += "?" + encoded }
	return path + "#/queue"
}

func registryURL(surface SurfaceModel) string {
	values := url.Values{}
	if surface.Query != "" { values.Set("q", surface.Query) }
	if surface.Lifecycle != "" && surface.Lifecycle != "all" { values.Set("lifecycle", surface.Lifecycle) }
	path := "/console/agents"
	if encoded := values.Encode(); encoded != "" { path += "?" + encoded }
	return path + "#/agents"
}

func recordURL(surface SurfaceModel, key string) string {
	return detailRoute(surface, key)
}

func collectionRoute(surface SurfaceModel) string {
	if surface.CollectionURL != "" { return surface.CollectionURL }
	values := url.Values{}
	if surface.Query != "" { values.Set("q", surface.Query) }
	if surface.Domain == DomainQueue {
		if surface.QueueState != "" && surface.QueueState != "all" { values.Set("state", surface.QueueState) }
	} else if surface.Domain == DomainCredentials {
		if surface.Lifecycle != "" && surface.Lifecycle != "all" { values.Set("status", surface.Lifecycle) }
	} else if surface.Lifecycle != "" && surface.Lifecycle != "all" {
		values.Set("lifecycle", surface.Lifecycle)
	}
	path := "/console/" + surface.Domain
	if encoded := values.Encode(); encoded != "" { path += "?" + encoded }
	return path + "#/" + surface.Domain
}

func detailRoute(surface SurfaceModel, key string) string {
	base := collectionRoute(surface)
	if index := strings.IndexByte(base, '#'); index >= 0 { base = base[:index] }
	separator := "?"
	if strings.Contains(base, "?") { separator = "&" }
	return base + separator + "record_key=" + url.QueryEscape(key) + "#/" + surface.Domain + "/" + url.PathEscape(key)
}

func agentRevisionRoute(surface SurfaceModel, record *RecordModel) string {
	parsed, err := url.Parse(detailRoute(surface, record.Key))
	if err != nil || record.Agent == nil { return collectionRoute(surface) }
	query := parsed.Query()
	query.Set("revision", strconv.FormatUint(record.Agent.Revision, 10))
	parsed.RawQuery = query.Encode()
	return parsed.String()
}

func agentMark(label string) string {
	label = strings.TrimSpace(label)
	if label == "" { return "?" }
	return strings.ToUpper(string([]rune(label)[0]))
}

func fallbackTitle(title string) string { if title == "" { return "Fleet workspace" }; return title }
func documentTitle(model PageModel) string { if model.CharterImport && model.Authenticated { return "Agent registration · Aegis Console" }; return "Aegis Console" }
func currentPage(current bool) string { if current { return "page" }; return "false" }
func actionTitle(action ActionModel) string { return action.State + ": " + action.ReasonCode }
func hasBlockedAction(actions []ActionModel) bool { for _, action := range actions { if action.State != "ready" { return true } }; return false }
func actionTag(state string) string { if state == "denied" { return "tag-denied" }; if state == "degraded_repair_required" { return "tag-degraded" }; return "tag-locked" }
func collectionSingular(domain string) string { if domain == DomainGraphs { return "graph" }; return "Loop" }
func countLabel(count int, singular string) string { suffix := "s"; if count == 1 { suffix = "" }; return fmt.Sprintf("%d %s%s", count, singular, suffix) }
func graphRunURL(record *RecordModel) string { return "/console/graphs/run?graph=" + url.QueryEscape(record.Label) + "&revision=" + strings.TrimPrefix(record.Revision, "r") + "&digest=" + url.QueryEscape(record.Graph.Digest) }
func stateHeading(state string) string {
	if state == "" { return "Unknown" }
	if state == "degraded_repair_required" { return "Repair required" }
	return strings.ToUpper(state[:1]) + state[1:]
}
func stateMessage(state string) string {
	switch state {
	case "empty": return "The authoritative collection is empty."
	case "denied": return "This collection read was denied. No count is asserted."
	case "unavailable": return "Fleet control is unavailable. This is not an empty collection."
	case "degraded_repair_required": return "Fleet state is degraded and requires repair. No count is asserted."
	case "loading": return "Loading authoritative state…"
	default: return "Fleet state could not be loaded or validated."
	}
}
