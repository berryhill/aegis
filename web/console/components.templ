package consoleweb

import "fmt"

templ Document(model PageModel) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="dark light"/>
			<title>Aegis Console</title>
			<link rel="stylesheet" href="/console/assets/app.css"/>
			<script type="module" src="/console/assets/datastar-v1.0.2.js"></script>
		</head>
		<body>
			<a class="skip-link" href="#workspace">Skip to fleet workspace</a>
			@Header(model.Authenticated, model.CSRF)
			<div class="shell">
				@Navigation(model.Surface.Domain, model.Authenticated)
				<main id="workspace" tabindex="-1">
					if model.Authenticated {
						@Workspace(model.Surface)
					} else {
						@Authentication("")
					}
				</main>
			</div>
		</body>
	</html>
}

templ Header(authenticated bool, csrf string) {
	<header id="console-header">
		<strong>Aegis</strong><span>Authenticated control plane</span>
		if authenticated {
			<button id="logout" type="button" data-signals={ fmt.Sprintf(`{"csrf":%q}`, csrf) } data-on:click="@delete('/console/session', {headers: {'X-CSRF-Token': $csrf}})">Sign out</button>
		}
	</header>
}

templ Navigation(domain string, authenticated bool) {
	<nav id="domain-navigation" aria-label="Control-plane domains">
		if authenticated {
			@NavigationButton(DomainAgents, "Agent Registry", domain == DomainAgents)
			@NavigationButton(DomainLoops, "Loops", domain == DomainLoops)
			@NavigationButton(DomainGraphs, "Graphs", domain == DomainGraphs)
			@NavigationButton(DomainQueue, "Execution Queue", domain == DomainQueue)
		}
	</nav>
}

templ NavigationButton(domain string, label string, current bool) {
	<button type="button" data-on:click={ fmt.Sprintf("@get('/console/fragments/surface?domain=%s')", domain) } aria-current={ currentPage(current) }>{ label }</button>
}

templ Authentication(message string) {
	<section id="authentication" aria-labelledby="authentication-title">
		<h1 id="authentication-title">Authenticate this browser</h1>
		<p>Obtain a single-use browser bootstrap from an already authenticated local Aegis client. It cannot create or change principal authority.</p>
		<p id="authentication-status" role="status" aria-live="polite">
			if message != "" {
				{ message }
			} else {
				A short-lived browser session is required.
			}
		</p>
		<form id="session-form" data-on:submit__prevent="@post('/console/session')">
			<label for="bootstrap">Single-use bootstrap</label>
			<input id="bootstrap" name="bootstrap" type="password" autocomplete="off" required data-bind:bootstrap/>
			<button type="submit">Start short-lived session</button>
		</form>
		<div class="service-state" data-state="loading" hidden>Loading…</div>
		<div class="service-state" data-state="empty" hidden>The authoritative collection is empty.</div>
		<div class="service-state" data-state="unavailable" hidden>Fleet control is unavailable. This is not an empty collection.</div>
		<div class="service-state" data-state="error" hidden>Fleet state could not be loaded or validated.</div>
	</section>
}

templ Workspace(surface SurfaceModel) {
	<section id="fleet" class="list-detail" aria-labelledby="surface-title">
		<div>
			<h1 id="surface-title">{ surface.Title }</h1>
			<p id="service-status" role="status" aria-live="polite">{ surface.Status }</p>
			if surface.State != "ready" {
				<div class="service-state" data-state={ surface.State }>{ stateMessage(surface.State) }</div>
			}
			<ul id="surface-list" aria-label="Fleet control records">
				for _, record := range surface.Records {
					<li><button id={ "record-" + record.Key } type="button" data-on:click={ fmt.Sprintf("@get('/console/fragments/inspect?domain=%s&record_key=%s')", surface.Domain, record.Key) }>@RecordLabel(record.Label)</button></li>
				}
			</ul>
		</div>
		@Inspector(surface.Inspector, surface.InspectorOpen)
	</section>
}

templ Inspector(record *RecordModel, open bool) {
	<aside id="inspector" class="inspector" aria-labelledby="inspector-title" tabindex="-1" hidden?={ !open }>
		<button id="close-inspector" type="button" aria-label="Close inspector" data-on:click="el.closest('aside').hidden = true">Close</button>
		<h2 id="inspector-title">Record inspector</h2>
		if record != nil {
			<p id="inspector-summary">{ record.Summary }</p>
			<pre id="inspector-record">{ record.JSON }</pre>
		}
	</aside>
}

templ RecordLabel(label string) { <span>{ label }</span> }

func currentPage(current bool) string {
	if current { return "page" }
	return "false"
}

func stateMessage(state string) string {
	switch state {
	case "empty": return "The authoritative collection is empty."
	case "unavailable": return "Fleet control is unavailable. This is not an empty collection."
	default: return "Fleet state could not be loaded or validated."
	}
}
