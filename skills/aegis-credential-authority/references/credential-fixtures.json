{
  "schema_version": 1,
  "fixtures": [
    {
      "id": "principal-stores-and-binds-current-version",
      "operation": "aegis.credential-authority.operate",
      "authoritative_result": {
        "authenticated_principal": "principal-example",
        "record": {
          "record_id": "record-example",
          "reference": "github-read-example",
          "kind": "opaque",
          "status": "active",
          "current_version": 2,
          "value_returned": false
        },
        "binding": {
          "agent_id": "agent-example",
          "stanza_id": "operator",
          "deployment_id": "deployment-example",
          "scope": "github/read",
