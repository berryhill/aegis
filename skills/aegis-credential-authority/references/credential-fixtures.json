          "destinations": ["github-api"],
          "version_policy": "current",
          "enabled": true
        }
      },
      "expected_interpretation": "The non-secret metadata and exact binding may be reported. The binding is not a session capability or proof of runtime use, and no credential value may be requested or returned."
