    "shipped": "Concrete public product transport exists; installation does not authorize use or prove acceptance.",
    "missing-adapter": "Product capability exists through another surface, but the named transport adapter does not.",
    "advisory": "Explanation or review only; no authoritative effect.",
    "unavailable": "No supported public operation; do not simulate it."
  },
